[TEMPLATE]
PORT=3000
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.cdyxnwhlfmogbqkohrur:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.cdyxnwhlfmogbqkohrur:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Khóa ký cookie phiên đăng nhập (tối thiểu 32 ký tự). Sinh mới bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=[generate_a_random_32_byte_hex_string]

# Origin dùng để dựng liên kết đặt lại mật khẩu trong email
APP_BASE_URL=http://localhost:3000

# Gửi email giao dịch: "console" (chỉ in ra terminal, không gửi thật) hoặc "smtp"
# Để nhận OTP qua email, đặt MAIL_DRIVER=smtp và điền đầy đủ cấu hình SMTP bên dưới.
MAIL_DRIVER=console
MAIL_FROM="Bep Nha <no-reply@bepnha.local>"

# Chỉ cần khi MAIL_DRIVER=smtp (ví dụ Gmail, Mailtrap, Postmark, SendGrid SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Danh sách email được cấp quyền quản trị (cách nhau bằng dấu phẩy).
# Chỉ các route /admin/* mới yêu cầu quyền này; khách vẫn xem được thực đơn.
ADMIN_EMAILS=
