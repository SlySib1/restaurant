<%- include('../partials/header', { title: 'Đặt lại mật khẩu' }) %>
<section class="auth-shell">
  <div class="auth-intro">
    <p class="eyebrow">Bảo mật tài khoản</p>
    <h1>Tạo mật khẩu mới cho tài khoản <%= email %>.</h1>
    <p class="page-intro">Sau khi đổi mật khẩu, mọi phiên đăng nhập cũ trên các thiết bị khác sẽ bị thu hồi. Bạn sẽ cần đăng nhập lại bằng mật khẩu mới.</p>
    <ul class="auth-points">
      <li>Liên kết này chỉ dùng được một lần.</li>
      <li>Mật khẩu mới được băm bằng bcrypt trước khi lưu.</li>
    </ul>
  </div>

  <div class="panel auth-card">
    <p class="eyebrow">Mật khẩu mới</p>
    <h2>Đặt lại mật khẩu</h2>

    <% if (errors && errors.length) { %>
      <div class="error-box" role="alert">
        <% errors.forEach(error => { %><p><%= error %></p><% }) %>
      </div>
    <% } %>

    <form class="form-stack" action="/auth/reset-password/<%= encodeURIComponent(token) %>" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="password">Mật khẩu mới</label>
        <input id="password" type="password" name="password" minlength="8" maxlength="72" required autocomplete="new-password" autofocus>
        <p class="hint">Ít nhất 8 ký tự, có cả chữ và số.</p>
      </div>

      <div class="field">
        <label for="confirmPassword">Nhập lại mật khẩu mới</label>
        <input id="confirmPassword" type="password" name="confirmPassword" minlength="8" maxlength="72" required autocomplete="new-password">
      </div>

      <div class="button-row">
        <button type="submit">Lưu mật khẩu mới</button>
        <a class="button button-secondary" href="/auth/login">Huỷ</a>
      </div>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
