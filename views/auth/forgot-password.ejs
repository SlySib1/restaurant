<%- include('../partials/header', { title: 'Quên mật khẩu' }) %>
<section class="auth-shell">
  <div class="auth-intro">
    <p class="eyebrow">Khôi phục truy cập</p>
    <h1>Quên mật khẩu? Chúng tôi gửi liên kết đặt lại.</h1>
    <p class="page-intro">Nhập email của tài khoản. Nếu email tồn tại, bạn sẽ nhận một liên kết dùng một lần có hiệu lực 30 phút. Vì lý do bảo mật, chúng tôi luôn trả về cùng một thông báo.</p>
    <ul class="auth-points">
      <li>Liên kết chỉ dùng được một lần và được lưu dưới dạng hash trong database.</li>
      <li>Đặt lại mật khẩu sẽ đăng xuất mọi thiết bị đang đăng nhập.</li>
    </ul>
  </div>

  <div class="panel auth-card">
    <p class="eyebrow">Đặt lại mật khẩu</p>
    <h2>Tìm tài khoản của bạn</h2>

    <% if (errors && errors.length) { %>
      <div class="error-box" role="alert">
        <% errors.forEach(error => { %><p><%= error %></p><% }) %>
      </div>
    <% } %>

    <form class="form-stack" action="/auth/forgot-password" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="email">Email đã đăng ký</label>
        <input id="email" type="email" name="email" value="<%= formData.email || '' %>" maxlength="254" required autocomplete="email" autofocus>
      </div>

      <div class="button-row">
        <button type="submit">Gửi liên kết đặt lại</button>
        <a class="button button-secondary" href="/auth/login">Về đăng nhập</a>
      </div>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
