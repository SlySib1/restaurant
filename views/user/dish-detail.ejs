<%- include('../partials/header', { title: dish.name }) %>
<p class="eyebrow"><a href="/dishes">← Trở lại thực đơn</a></p>
<section class="panel detail-panel">
  <div>
    <p class="eyebrow"><%= dish.category %></p>
    <h1><%= dish.name %></h1>
    <p><%= dish.description || 'Một món ngon được chuẩn bị tận tâm từ căn bếp của chúng tôi.' %></p>
    <p class="price"><%= dish.price.toLocaleString('vi-VN') %> ₫</p>
    <p><span class="badge <%= dish.available ? '' : 'badge-unavailable' %>"><%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %></span></p>
    <h2>Đầu bếp</h2>
    <ul><% dish.chefs.forEach(chef => { %><li><%= chef.name %> · <%= chef.specialty %></li><% }) %></ul>
    <h2>Nguyên liệu</h2>
    <ul><% dish.ingredients.forEach(ingredient => { %><li><%= ingredient.name %> · <%= ingredient.unit %></li><% }) %></ul>
  </div>
  <div>
    <% if (dish.imageUrl) { %><img class="image-preview" src="<%= dish.imageUrl %>" alt="<%= dish.name %>">
    <% } else { %><div class="image-preview image-placeholder" aria-label="Chưa có ảnh">Bếp Nhà</div><% } %>
  </div>
</section>
<%- include('../partials/footer') %>
