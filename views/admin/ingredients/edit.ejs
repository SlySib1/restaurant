<%- include('../../partials/header', { title: 'Sửa nguyên liệu' }) %>
<p class="eyebrow">Cập nhật kho bếp</p>
<h1>Sửa nguyên liệu</h1>
<p class="page-intro">Mã bản ghi #<%= ingredient.id %> · Chỉnh sửa thông tin và hình ảnh nguyên liệu.</p>

<% if (errors.length > 0) { %>
  <div class="error-box"><% errors.forEach(err => { %><p><%= err %></p><% }) %></div>
<% } %>

<section class="panel">
  <form action="/admin/ingredients/<%= ingredient.id %>?_method=PATCH" method="POST" enctype="multipart/form-data" class="form-stack">
    <div class="field"><label for="name">Tên nguyên liệu</label><input id="name" type="text" name="name" value="<%= ingredient.name %>" required></div>
    <div class="field"><label for="unit">Đơn vị tính</label><input id="unit" type="text" name="unit" value="<%= ingredient.unit %>" required></div>
    <div class="field">
      <label for="image">Ảnh nguyên liệu</label>
      <input id="image" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" data-image-input>
      <span class="hint">Chọn ảnh mới để thay thế ảnh hiện tại. JPEG, PNG, WebP hoặc GIF · tối đa 5 MB</span>
      <img class="image-preview" data-image-preview src="<%= ingredient.imageUrl || '' %>" alt="Ảnh nguyên liệu" <%= ingredient.imageUrl ? '' : 'hidden' %>>
      <% if (ingredient.imageUrl) { %><label class="check-row"><input type="checkbox" name="removeImage" value="on"> Xóa ảnh hiện tại</label><% } %>
    </div>
    <div class="button-row"><button type="submit">Lưu thay đổi</button><a class="button button-secondary" href="/admin/ingredients">Quay lại</a></div>
  </form>
</section>
<%- include('../../partials/footer') %>
