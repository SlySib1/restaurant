<%- include('../../partials/header', { title: 'Xóa đầu bếp' }) %>
<section class="panel confirm-panel">
  <p class="eyebrow">Xác nhận thao tác</p>
  <h1>Xóa đầu bếp?</h1>
  <p>Bạn có chắc muốn xóa <strong><%= chef.name %></strong>? Món còn đầu bếp khác sẽ được giữ nguyên.</p>

  <% if (orphanDishes.length > 0) { %>
    <div class="error-box">
      <strong><%= orphanDishes.length %> món sẽ bị xóa vì không còn đầu bếp nào khác:</strong>
      <ul><% orphanDishes.forEach(dish => { %><li><%= dish.name %></li><% }) %></ul>
    </div>
  <% } else { %>
    <p class="badge">Không có món nào bị xóa.</p>
  <% } %>

  <% if (retainedDishes.length > 0) { %>
    <div class="notice-box">
      <strong><%= retainedDishes.length %> món được giữ lại nhờ đầu bếp khác:</strong>
      <ul><% retainedDishes.forEach(dish => { %><li><%= dish.name %> · <%= dish.chefs.filter(other => other.id !== chef.id).map(other => other.name).join(', ') %></li><% }) %></ul>
    </div>
  <% } %>

  <form action="/admin/chefs/<%= chef.id %>?_method=DELETE" method="POST" class="button-row">
    <button class="button-danger" type="submit">Xác nhận xóa đầu bếp</button>
    <a class="button button-secondary" href="/admin/chefs">Hủy</a>
  </form>
</section>
<%- include('../../partials/footer') %>
