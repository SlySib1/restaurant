<%- include('../../partials/header', { title: 'Xóa món ăn' }) %>
<section class="panel confirm-panel">
  <p class="eyebrow">Xác nhận thao tác</p>
  <h1>Xóa món ăn?</h1>
  <p>Bạn có chắc muốn xóa <strong><%= dish.name %></strong>? Ảnh đi kèm cũng sẽ bị xóa.</p>
  <form action="/admin/dishes/<%= dish.id %>?_method=DELETE" method="POST" class="button-row">
    <button class="button-danger" type="submit">Xóa món ăn</button>
    <a class="button button-secondary" href="/admin/dishes">Hủy</a>
  </form>
</section>
<%- include('../../partials/footer') %>
