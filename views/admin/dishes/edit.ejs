<%- include('../../partials/header', { title: 'Sửa món ăn' }) %>
<p class="eyebrow">Cập nhật thực đơn</p>
<h1>Sửa món ăn</h1>
<p class="page-intro">Mã bản ghi #<%= dish.id %> · Chỉnh sửa thông tin và hình ảnh món ăn.</p>

<% if (errors.length > 0) { %>
  <div class="error-box"><% errors.forEach(err => { %><p><%= err %></p><% }) %></div>
<% } %>

<section class="panel">
  <form action="/admin/dishes/<%= dish.id %>?_method=PATCH" method="POST" enctype="multipart/form-data" class="form-stack">
    <div class="field"><label for="name">Tên món</label><input id="name" type="text" name="name" value="<%= dish.name %>" required></div>
    <div class="field"><label for="description">Mô tả</label><textarea id="description" name="description"><%= dish.description %></textarea></div>
    <div class="field"><label for="price">Giá (VNĐ)</label><input id="price" type="number" step="0.01" min="0" name="price" value="<%= dish.price %>" required></div>
    <div class="field"><label for="category">Danh mục</label><input id="category" type="text" name="category" value="<%= dish.category %>"></div>
    <fieldset class="relation-picker">
      <legend>Đầu bếp có thể chế biến <span class="hint">(chọn ít nhất một)</span></legend>
      <% chefs.forEach(chefOption => { %>
        <label class="check-row">
          <input type="checkbox" name="chefIds" value="<%= chefOption.id %>" <%= selectedChefIds.includes(chefOption.id) ? 'checked' : '' %>>
          <%= chefOption.name %> · <%= chefOption.specialty %>
        </label>
      <% }) %>
      <% if (chefs.length === 0) { %><span class="hint">Hãy thêm đầu bếp trước khi sửa món.</span><% } %>
    </fieldset>
    <fieldset class="relation-picker">
      <legend>Nguyên liệu cần có <span class="hint">(chọn ít nhất một)</span></legend>
      <% ingredients.forEach(ingredientOption => { %>
        <label class="check-row">
          <input type="checkbox" name="ingredientIds" value="<%= ingredientOption.id %>" <%= selectedIngredientIds.includes(ingredientOption.id) ? 'checked' : '' %>>
          <%= ingredientOption.name %> · <%= ingredientOption.unit %>
        </label>
      <% }) %>
      <% if (ingredients.length === 0) { %><span class="hint">Hãy thêm nguyên liệu trước khi sửa món.</span><% } %>
    </fieldset>
    <div class="field">
      <label for="image">Ảnh món ăn</label>
      <input id="image" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" data-image-input>
      <span class="hint">Chọn ảnh mới để thay thế ảnh hiện tại. JPEG, PNG, WebP hoặc GIF · tối đa 5 MB</span>
      <img class="image-preview" data-image-preview src="<%= dish.imageUrl || '' %>" alt="Ảnh món ăn" <%= dish.imageUrl ? '' : 'hidden' %>>
      <% if (dish.imageUrl) { %><label class="check-row"><input type="checkbox" name="removeImage" value="on"> Xóa ảnh hiện tại</label><% } %>
    </div>
    <label class="check-row"><input type="checkbox" name="available" <%= dish.available ? 'checked' : '' %>> Đang phục vụ</label>
    <div class="button-row"><button type="submit">Lưu thay đổi</button><a class="button button-secondary" href="/admin/dishes">Quay lại</a></div>
  </form>
</section>
<%- include('../../partials/footer') %>
