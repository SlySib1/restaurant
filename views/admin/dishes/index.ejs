<%- include('../../partials/header', { title: 'Quản lý món ăn' }) %>
<p class="eyebrow">Khu vực quản trị</p>
<h1>Quản lý món ăn</h1>
<p class="page-intro">Thêm món mới, cập nhật thực đơn và chia sẻ hình ảnh hấp dẫn cho khách hàng.</p>

<% if (errors.length > 0) { %>
  <div class="error-box"><% errors.forEach(err => { %><p><%= err %></p><% }) %></div>
<% } %>

<div class="admin-grid">
  <section class="panel">
    <h2>Thêm món mới</h2>
    <form action="/admin/dishes" method="POST" enctype="multipart/form-data" class="form-stack">
      <div class="field">
        <label for="name">Tên món</label>
        <input id="name" type="text" name="name" value="<%= formData.name || '' %>" required>
      </div>
      <div class="field">
        <label for="description">Mô tả</label>
        <textarea id="description" name="description"><%= formData.description || '' %></textarea>
      </div>
      <div class="field">
        <label for="price">Giá (VNĐ)</label>
        <input id="price" type="number" step="0.01" min="0" name="price" value="<%= formData.price || '' %>" required>
      </div>
      <div class="field">
        <label for="category">Danh mục</label>
        <input id="category" type="text" name="category" value="<%= formData.category || '' %>">
      </div>
      <fieldset class="relation-picker">
        <legend>Đầu bếp có thể chế biến <span class="hint">(chọn ít nhất một)</span></legend>
        <% chefs.forEach(chef => { %>
          <label class="check-row">
            <input type="checkbox" name="chefIds" value="<%= chef.id %>" <%= selectedChefIds.includes(chef.id) ? 'checked' : '' %>>
            <%= chef.name %> · <%= chef.specialty %>
          </label>
        <% }) %>
        <% if (chefs.length === 0) { %><span class="hint">Hãy thêm đầu bếp trước khi tạo món.</span><% } %>
      </fieldset>
      <fieldset class="relation-picker">
        <legend>Nguyên liệu cần có <span class="hint">(chọn ít nhất một)</span></legend>
        <% ingredients.forEach(ingredient => { %>
          <label class="check-row">
            <input type="checkbox" name="ingredientIds" value="<%= ingredient.id %>" <%= selectedIngredientIds.includes(ingredient.id) ? 'checked' : '' %>>
            <%= ingredient.name %> · <%= ingredient.unit %>
          </label>
        <% }) %>
        <% if (ingredients.length === 0) { %><span class="hint">Hãy thêm nguyên liệu trước khi tạo món.</span><% } %>
      </fieldset>
      <div class="field">
        <label for="image">Ảnh món ăn</label>
        <input id="image" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" data-image-input>
        <span class="hint">JPEG, PNG, WebP hoặc GIF · tối đa 5 MB</span>
        <img class="image-preview" data-image-preview alt="Xem trước ảnh món ăn" hidden>
      </div>
      <label class="check-row"><input type="checkbox" name="available" <%= formData.available === 'on' ? 'checked' : '' %>> Đang phục vụ</label>
      <button type="submit">Thêm món ăn</button>
    </form>
  </section>

  <section class="panel">
    <div class="section-heading">
      <div><h2>Danh sách món ăn</h2><p><%= dishes.length %> món trong thực đơn</p></div>
    </div>
    <% if (dishes.length === 0) { %>
      <div class="empty-state">Chưa có món ăn nào. Hãy thêm món đầu tiên.</div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>STT</th><th>Ảnh</th><th>Tên món</th><th>Đầu bếp</th><th>Nguyên liệu</th><th>Giá</th><th>Hành động</th></tr></thead>
          <tbody>
            <% dishes.forEach((dish, index) => { %>
              <tr>
                <td class="row-number"><%= index + 1 %></td>
                <td>
                  <% if (dish.imageUrl) { %><img class="table-thumb" src="<%= dish.imageUrl %>" alt="<%= dish.name %>">
                  <% } else { %><div class="table-thumb image-placeholder" aria-label="Chưa có ảnh">Bếp</div><% } %>
                </td>
                <td><strong><%= dish.name %></strong><br><span class="badge <%= dish.available ? '' : 'badge-unavailable' %>"><%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %></span></td>
                <td><%= dish.chefs.map(chef => chef.name).join(', ') || 'Chưa phân công' %></td>
                <td><%= dish.ingredients.map(ingredient => ingredient.name).join(', ') || 'Chưa khai báo' %></td>
                <td><%= dish.price.toLocaleString('vi-VN') %> ₫</td>
                <td class="actions"><a href="/admin/dishes/<%= dish.id %>/edit">Sửa</a><a href="/admin/dishes/<%= dish.id %>/delete">Xóa</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
<%- include('../../partials/footer') %>
